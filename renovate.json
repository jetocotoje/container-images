{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "UTC",

  "packageRules": [
    {
      "matchCategories": ["docker"],
      "enabled": true,
      "pinDigests": true,
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "Major docker updates automerge through a PR once its build passes",
      "matchCategories": ["docker"],
      "matchUpdateTypes": ["major"],
      "automergeType": "pr",
      "ignoreTests": false,
      "platformAutomerge": false
    },
    {
      "matchFileNames": ["lidarr/Dockerfile"],
      "groupName": "lidarr image inputs",
      "groupSlug": "lidarr-image-inputs"
    },
    {
      "description": "Bump base image digests together once a week, before the Monday 04:00 UTC rebuild",
      "matchCategories": ["docker"],
      "matchUpdateTypes": ["digest"],
      "groupName": "base image digests",
      "groupSlug": "base-image-digests",
      "schedule": ["* 0-3 * * 1"]
    },
    {
      "description": "Numeric image tags: allow 2- and 3-segment versions (docker versioning blocks cross-schema updates, e.g. jellyfin 10.11.11 -> 12.0)",
      "matchDepNames": [
        "ghcr.io/jellyfin/jellyfin",
        "ghcr.io/librespeed/speedtest",
        "opencloudeu/opencloud-rolling",
        "docker.io/library/php"
      ],
      "versioning": "regex:^[vV]?(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:-(?<compatibility>.*))?$"
    },
    {
      "matchCategories": ["!docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "matchDepNames": [
        "brainicism/bgutil-ytdlp-pot-provider",
        "Brainicism/bgutil-ytdlp-pot-provider@BGUTIL_PLUGIN_VERSION"
      ],
      "groupName": "bgutil provider and plugin",
      "groupSlug": "bgutil-provider-and-plugin",
      "automerge": false
    }
  ],

  "customDatasources": {
    "servarr-nightly": {
      "defaultRegistryUrlTemplate": "https://{{packageName}}.servarr.com/v1/update/nightly/changes?os=linux&runtime=netcore&arch=x64",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": $.{\"version\": version, \"releaseTimestamp\": releaseDate}}"
      ]
    }
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Update *_VERSION args in Dockerfiles based on # renovate: comments on previous line (quoted or unquoted)",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=\"?(?<versioning>[^\"\\s]+)\"?)?\\s*(?:\\s+extractVersion=\"?(?<extractVersion>[^\"\\s]+)\"?)?\\s*\\nARG\\s+(?<argName>[A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*\"?((?<currentValue>[^\"\\s]+))\"?"
      ],
      "depNameTemplate": "{{{ depName }}}@{{{ argName }}}",
      "packageNameTemplate": "{{{ depName }}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{/if}}"
    }
  ]
}
